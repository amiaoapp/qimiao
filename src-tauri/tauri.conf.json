{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "启喵",
  "version": "0.9.7",
  "identifier": "com.appmiao.miaoqi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "启喵",
        "width": 1024,
        "height": 656,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**", "/private/var/folders/**", "/var/folders/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "signingIdentity": "-" },
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "启喵：智能跨平台应用启动器 / qimiao smart cross-platform launcher"
  }
}
